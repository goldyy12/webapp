generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model Store {
  id        Int    @id @default(autoincrement())
  name      String
  address   String
  city      String
  type      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  content   String?
}